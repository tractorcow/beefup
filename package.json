{
  "name": "beefup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Staged, pinned, audited dependency upgrades for npm and pnpm.",
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "beefup": "./dist/bin.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/bin.js",
    "test": "tsx --test --test-reporter spec $(find src -name '*.test.ts')"
  },
  "dependencies": {
    "cve-lite-cli": "1.29.0",
    "semver": "7.8.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/semver": "7.7.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
